{
  "name": "sift",
  "version": "0.1.0",
  "private": true,
  "description": "Sift — 本地优先的 Electron 桌面应用，把下载文件夹变成可理解、可检索、可审计的整理系统",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:renderer && npm run build:main && electron .",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "build:renderer": "next build && node scripts/copy-standalone.mjs",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --loader:.sql=text --external:electron --external:better-sqlite3 --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "chokidar": "6.0.0",
    "next": "16.4.3",
    "pdf-parse": "2.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
